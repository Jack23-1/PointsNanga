  @@unique([id_eleve, id_annee_scolaire], map: "uq_eleve_annee")
  @@unique([id_classe, id_annee_scolaire, numero_ordre], map: "uq_numero_ordre_classe")
  @@index([id_classe, id_annee_scolaire], map: "idx_inscriptions_classe_annee")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model options_scolaires {
  id_option        BigInt         @id @default(autoincrement())
  id_ecole         BigInt
  libelle          String         @db.VarChar(100)
  code_option      String?        @db.VarChar(30)
  description      String?
  statut           statut_general @default(ACTIF)
  date_creation    DateTime       @default(now()) @db.Timestamptz(6)
  date_mise_a_jour DateTime       @default(now()) @db.Timestamptz(6)
  classes          classes[]
  ecoles           ecoles         @relation(fields: [id_ecole], references: [id_ecole], onUpdate: NoAction, map: "fk_option_ecole")

  @@unique([id_ecole, code_option], map: "uq_option_code")
  @@unique([id_ecole, libelle], map: "uq_option_libelle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model periodes {
  id_periode        BigInt           @id @default(autoincrement())
  id_annee_scolaire BigInt
  libelle           String           @db.VarChar(100)
  numero            Int
  date_debut        DateTime?        @db.Date
  date_fin          DateTime?        @db.Date
  est_ouverte       Boolean          @default(false)
  statut            statut_general   @default(ACTIF)
  date_creation     DateTime         @default(now()) @db.Timestamptz(6)
  date_mise_a_jour  DateTime         @default(now()) @db.Timestamptz(6)
  cotes             cotes[]
  annees_scolaires  annees_scolaires @relation(fields: [id_annee_scolaire], references: [id_annee_scolaire], onUpdate: NoAction, map: "fk_periode_annee")
  resultats         resultats[]

  @@unique([id_annee_scolaire, libelle], map: "uq_periode_libelle")
  @@unique([id_annee_scolaire, numero], map: "uq_periode_numero")
}

model professeurs {
  id_professeur            BigInt                     @id @default(autoincrement())
  id_ecole                 BigInt
  matricule                String?                    @db.VarChar(50)
  nom                      String                     @db.VarChar(100)
  postnom                  String?                    @db.VarChar(100)
  prenom                   String                     @db.VarChar(100)
  sexe                     String?                    @db.VarChar(20)
  telephone                String?                    @db.VarChar(30)
  photo                    String?
  email                    String?                    @db.VarChar(150)
  adresse                  String?                    @db.VarChar(255)
  specialite               String?                    @db.VarChar(150)
  statut                   statut_general             @default(ACTIF)
  date_creation            DateTime                   @default(now()) @db.Timestamptz(6)
  date_mise_a_jour         DateTime                   @default(now()) @db.Timestamptz(6)
  affectations_professeurs affectations_professeurs[]
  ecoles                   ecoles                     @relation(fields: [id_ecole], references: [id_ecole], onUpdate: NoAction, map: "fk_professeur_ecole")
  titulaires               titulaires[]

  @@unique([id_ecole, matricule], map: "uq_professeur_matricule")
  @@index([id_ecole], map: "idx_professeurs_ecole")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resultats {
  id_resultat       BigInt             @id @default(autoincrement())
  id_inscription    BigInt
  id_periode        BigInt
  total_obtenu      Decimal            @default(0) @db.Decimal(10, 2)
  total_ponderation Decimal            @default(0) @db.Decimal(10, 2)
  pourcentage       Decimal            @default(0) @db.Decimal(6, 2)
  moyenne           Decimal?           @db.Decimal(6, 2)
  rang              Int?
  mention           mention_resultat?
  decision          decision_resultat?
  statut            statut_resultat    @default(BROUILLON)
  date_calcul       DateTime           @default(now()) @db.Timestamptz(6)
  date_publication  DateTime?          @db.Timestamptz(6)
  date_mise_a_jour  DateTime           @default(now()) @db.Timestamptz(6)
  inscriptions      inscriptions       @relation(fields: [id_inscription], references: [id_inscription], onUpdate: NoAction, map: "fk_resultat_inscription")
  periodes          periodes           @relation(fields: [id_periode], references: [id_periode], onUpdate: NoAction, map: "fk_resultat_periode")

  @@unique([id_inscription, id_periode], map: "uq_resultat_inscription_periode")
  @@index([id_periode], map: "idx_resultats_periode")
  @@index([rang], map: "idx_resultats_rang")
}

model titulaires {
  id_titulaire              BigInt           @id @default(autoincrement())
  id_professeur             BigInt
  id_classe                 BigInt
  id_annee_scolaire         BigInt
  id_directeur_createur     BigInt
  code_connexion            String           @unique @db.VarChar(50)
  mot_de_passe_hash         String
  doit_changer_mot_de_passe Boolean          @default(true)
  statut_compte             statut_compte    @default(ACTIF)
  derniere_connexion        DateTime?        @db.Timestamptz(6)
  date_nomination           DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  date_creation             DateTime         @default(now()) @db.Timestamptz(6)
  date_mise_a_jour          DateTime         @default(now()) @db.Timestamptz(6)
  cotes                     cotes[]
  annees_scolaires          annees_scolaires @relation(fields: [id_annee_scolaire], references: [id_annee_scolaire], onUpdate: NoAction, map: "fk_titulaire_annee")
  classes                   classes          @relation(fields: [id_classe], references: [id_classe], onUpdate: NoAction, map: "fk_titulaire_classe")
  directeurs                directeurs       @relation(fields: [id_directeur_createur], references: [id_directeur], onUpdate: NoAction, map: "fk_titulaire_directeur")
  professeurs               professeurs      @relation(fields: [id_professeur], references: [id_professeur], onUpdate: NoAction, map: "fk_titulaire_professeur")

  @@unique([id_professeur, id_classe, id_annee_scolaire], map: "uq_professeur_titulaire_classe_annee")
  @@unique([id_classe, id_annee_scolaire], map: "uq_titulaire_classe_annee")
  @@index([id_annee_scolaire], map: "idx_titulaires_annee")
  @@index([id_professeur], map: "idx_titulaires_professeur")
}

enum decision_resultat {
  ADMIS
  AJOURNE
  ECHEC
  REDOUBLE
  DIPLOME
}

enum mention_resultat {
  INSUFFISANT
  PASSABLE
  SATISFACTION
  DISTINCTION
  GRANDE_DISTINCTION
}

enum statut_annee_scolaire {
  PLANIFIEE
  EN_COURS
  CLOTUREE
}

enum statut_compte {
  ACTIF
  BLOQUE
  DESACTIVE
}

enum statut_general {
  ACTIF
  INACTIF
}

enum statut_inscription {
  INSCRIT
  TRANSFERE
  ABANDONNE
  EXCLU
  DIPLOME
}

enum statut_resultat {
  BROUILLON
  CALCULE
  PUBLIE
  VERROUILLE
}
